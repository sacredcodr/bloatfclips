#include <winver.h>

// Version shown in Explorer and used by installer/bloatfclips.iss (read from the built exe).
#define BFC_VERSION_NUM 0,1,0,0
#define BFC_VERSION_STR "0.1.0"

1 ICON "../assets/bloatfclips.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BFC_VERSION_NUM
PRODUCTVERSION BFC_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "bloatfclips instant replay"
            VALUE "FileVersion", BFC_VERSION_STR
            VALUE "InternalName", "bloatfclips"
            VALUE "OriginalFilename", "bloatfclips.exe"
            VALUE "ProductName", "bloatfclips"
            VALUE "ProductVersion", BFC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
